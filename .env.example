# Copy this file to .env and change what you need. Every setting is optional.

# Where the app listens. Keep 127.0.0.1 on a PC or behind a reverse proxy on a VPS.
HOST=127.0.0.1
PORT=3000

# Folder for the database, backups and the first-login file (relative to this folder).
DATA_DIR=data
DB_FILE=crm.db

# Email for the first admin account, created the first time the app starts on an empty database.
ADMIN_EMAIL=admin@sei.local

# Dates and "overdue" are worked out in this time zone.
TZ_NAME=Asia/Kolkata

# How long a sign-in lasts, in days.
SESSION_DAYS=7

# On a VPS behind HTTPS (Caddy or nginx), set both to 1.
COOKIE_SECURE=0
TRUST_PROXY=0

# Password for the demo users created by `npm run demo` (demo database only, never the real one).
DEMO_PASSWORD=sei-demo-2026
